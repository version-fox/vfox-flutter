# escape=`
FROM mcr.microsoft.com/windows/servercore:ltsc2025-KB5122871

SHELL ["powershell", "-NoProfile", "-Command"]

COPY tests/e2e/bootstrap-tools.ps1 C:\bootstrap-tools.ps1
RUN powershell -NoProfile -ExecutionPolicy Bypass -File 'C:\bootstrap-tools.ps1'

WORKDIR C:\e2e

COPY metadata.lua C:\e2e\metadata.lua
COPY hooks C:\e2e\hooks
COPY lib C:\e2e\lib
COPY tests/e2e C:\e2e\tests\e2e

ENTRYPOINT ["C:/Program Files/PowerShell/7/pwsh.exe", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "C:/e2e/tests/e2e/run.ps1"]
