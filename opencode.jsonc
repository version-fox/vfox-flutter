// Project-level OpenCode configuration: let agents push branches and open or
// comment on pull requests without asking. These rules are appended after the
// user's global ~/.config/opencode/opencode.json and the last matching rule
// wins, so they take priority over a personal `deny` on the same commands.
// `gh pr merge *` is intentionally not listed here.
{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "shell", "resource": "git push *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr create *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr comment *", "effect": "allow" }
  ]
}
